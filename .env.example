# Copy to .env and fill in real values before deploying. See src/wardline/common/config.py
# for the full list of settings and their defaults.

APP_NAME=wardline
ENVIRONMENT=development

# --- Postgres --- (use "postgres" as host when run via docker-compose, "localhost" for bare-metal dev)
# These same values also provision the postgres container in docker-compose.yml (via its
# top-level env-var substitution) — change them here once, not in two places.
POSTGRES_USER=wardline
POSTGRES_PASSWORD=wardline
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wardline
# Only set these if component fields above can't express your connection string
# (extra query params, a managed Postgres with a non-standard URL shape, etc).
DATABASE_URL_OVERRIDE=
DATABASE_URL_ASYNC_OVERRIDE=

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=wardline-dev-password

# --- Object store (MinIO by default; point at real S3 in production with no code change) ---
BLOB_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=wardline
S3_SECRET_KEY=wardline-dev-secret
S3_BUCKET=wardline-bronze
S3_REGION=us-east-1

# --- LLM backend ---
# Leave LLM_API_KEY unset and LLM_CLIENT_MODE=mock to run without a key (query/agent
# planes use a deterministic mock synthesizer). Set LLM_CLIENT_MODE=live + a real key for
# genuine grounded synthesis. LLM_PROVIDER selects the implementation in
# query/llm_client.py -- "anthropic" is the default and, for now, only one implemented.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-4-8
LLM_CLIENT_MODE=mock

# --- Governance / security ---
# MUST override in any real deployment — this is mixed into API-key hashing.
# Prefer a real secrets manager over this file: any of these settings can instead be provided as
# a file at /run/secrets/<field_name> (Docker secrets / Kubernetes Secret volumes / a Vault agent
# sidecar all work this way) and will take priority over the plain env var — see config.py.
API_KEY_PEPPER=change-me-to-a-long-random-value
KILL_SWITCH_ENABLED_DEFAULT=false

# --- Self-serve accounts (commercialization roadmap Pillar 1) ---
# Separate secret from API_KEY_PEPPER on purpose -- a leak of one shouldn't
# automatically compromise the other credential class. MUST override in
# any real deployment, same as API_KEY_PEPPER.
PASSWORD_PEPPER=change-me-to-a-different-long-random-value
AUTH_TOKEN_TTL_MINUTES=30
RECOVERY_CODE_COUNT=10
MFA_ISSUER=Wardline
# The web/ deployment's own origin -- used to build the links this app
# emails out (verify/reset/invite). Not the API's own URL.
APP_BASE_URL=http://localhost:5173
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Outbound email ("mock" logs instead of sending -- see common/email.py) ---
EMAIL_MODE=mock
EMAIL_FROM_ADDRESS=no-reply@wardline.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Auth mode: "api_key" (default, this project's own key system) or "oidc" ---
# Set AUTH_MODE=oidc to validate bearer tokens against a real identity provider instead of
# api_keys — points this at any OIDC-compliant IdP (Okta, Auth0, Keycloak, Entra ID). Leave unset
# to keep using API keys.
AUTH_MODE=api_key
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_ROLE_CLAIM=realm_access.roles

# --- Job dispatch: "postgres" (default, zero extra infra) or "kafka" ---
# `docker compose --profile kafka up kafka` for local use; see the README's scope-reductions table.
JOB_QUEUE_BACKEND=postgres
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_INGESTION_TOPIC=wardline-ingestion-jobs

# --- Lexical search: "postgres" (default, zero extra infra) or "opensearch" ---
# `docker compose --profile opensearch up opensearch` for local use.
LEXICAL_BACKEND=postgres
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=wardline-chunks

# --- OCR: "tesseract" (default, local) or "textract" (needs real AWS credentials via boto3's
# standard credential chain — not set here) ---
OCR_BACKEND=tesseract
TEXTRACT_REGION=us-east-1

# --- ASR (speech-to-text for uploaded audio/video) ---
# "tiny" is fast; "small"/"medium"/"large-v3" trade speed for accuracy on noisier recordings.
ASR_MODEL=tiny

# --- Periodic background jobs (worker container) ---
ENTITY_RESOLUTION_BATCH_ENABLED=true
ENTITY_RESOLUTION_BATCH_INTERVAL_SECONDS=21600
ICEBERG_EXPORT_ENABLED=true
ICEBERG_EXPORT_INTERVAL_SECONDS=21600

# --- Observability ---
# Unset OTEL_EXPORTER_OTLP_ENDPOINT (default): traces print to console. Point it at the bundled
# otel-collector service (see docker-compose.yml) or any real collector to ship elsewhere.
OTEL_CONSOLE_EXPORT=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Collection: crawler politeness ---
CRAWLER_USER_AGENT=wardline-research-bot/0.1 (+mailto:you@example.com)
SEC_EDGAR_USER_AGENT=wardline-research-bot you@example.com
# Required for the opencorporates connector — free non-commercial tier at
# https://opencorporates.com/api_accounts/new. Leave unset to skip that source.
OPENCORPORATES_API_TOKEN=

# --- Dual-use / engagement-scoped connectors ---
# Both of these are still gated by governance.pep.enforce_engagement_scope
# on every run — a caller needs an active Engagement whose target scope
# covers the requested target, not just an admin/analyst role. See
# docs/COMMERCIALIZATION_ROADMAP.md and README's "Authorized pentesting
# connectors" section before enabling either in anything customer-facing:
# Shodan's own Terms of Service govern redistribution/resale of data their
# API returns, and active scanning needs a real signed engagement, not just
# this flag being set.
#
# connectors/threat_intel.py (Shodan exposure lookups) — leave unset to skip.
SHODAN_API_KEY=
# connectors/nmap_scan.py's execution backend — the toolrunner sidecar
# (docker/toolrunner/), started via `docker compose --profile toolrunner up
# toolrunner`. Leave TOOLRUNNER_URL unset to skip active scanning entirely.
TOOLRUNNER_URL=
TOOLRUNNER_TOKEN=

# --- Billing (commercialization roadmap Pillar 5) ---
# "mock" (default) never calls Stripe -- checkout activates the plan
# locally and immediately, so billing is fully testable without a Stripe
# account. Set BILLING_MODE=stripe + the STRIPE_* values below (from your
# Stripe dashboard: API keys, a webhook endpoint pointed at
# POST /v1/billing/webhook, and a Price object per paid plan) to go live.
# Placeholder prices live in src/wardline/common/plans.py -- change them
# there; these env vars only carry the *Stripe Price ids* once they exist.
BILLING_MODE=mock
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=
BILLING_SUCCESS_URL=http://localhost:5173/app.html?billing=success
BILLING_CANCEL_URL=http://localhost:5173/pricing.html?billing=canceled
