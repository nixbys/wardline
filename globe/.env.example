# Copy to .env before `npm run dev` / `npm run build` if the wardline API
# isn't at the default below (Vite only exposes vars prefixed VITE_ to
# client code -- see api.js).
VITE_WARDLINE_API_BASE=http://localhost:8000

# Optional: enables Cesium World Terrain (real elevation data) via Cesium
# ion instead of the flat-ellipsoid default this app ships with when unset.
# Free account at https://ion.cesium.com/tokens. Leave unset to run with no
# Cesium account at all.
VITE_CESIUM_ION_TOKEN=
