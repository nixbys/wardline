FROM python:3.12-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./alembic.ini

RUN pip install --no-cache-dir -e ".[dev]" \
    && python -m spacy download en_core_web_sm

ENV PYTHONUNBUFFERED=1 \
    HOME=/home/wardline

# Non-root: same rationale as Dockerfile.api. The worker also downloads the
# HF model cache lazily, so HOME must be owned by this user.
RUN useradd --create-home --home-dir /home/wardline --shell /usr/sbin/nologin wardline \
    && chown -R wardline:wardline /app
USER wardline

CMD ["python", "-m", "wardline.worker.main"]
